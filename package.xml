<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>laser_uav_lib</name>
  <version>0.0.0</version>
  <description>A library for UAV laser processing</description>
  <maintainer email="wagnergarcia@eng.ci.ufpb.br">Wagner Dantas Garcia</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependências ROS 2 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Eigen3 (maneira correta no ROS 2) -->
  <depend>eigen3_cmake_module</depend>
  <depend>libeigen3-dev</depend>

  <!-- OpenCV (nome do pacote no ROS 2) -->
  <depend>opencv</depend>  <!-- ou "ros-${ROS_DISTRO}-opencv" -->

  <!-- PCL (nome do pacote no ROS 2) -->
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>
  <depend>libpcl-dev</depend>  <!-- ou "ros-${ROS_DISTRO}-pcl-msgs" -->

  <!-- Dependências de teste -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>